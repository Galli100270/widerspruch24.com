{
  "name": "Case",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "description": "Eine kurze, eindeutige und menschenlesbare Fallnummer (z.B. W24-ABC123)"
    },
    "origin": {
      "type": "string",
      "enum": [
        "letter",
        "scanner"
      ],
      "description": "Herkunft des Falls: Schreiben-Generator oder Scanner"
    },
    "letter_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung zum Letter-Objekt (wenn origin=letter)"
    },
    "title": {
      "type": "string",
      "description": "Kurzer, aussagekr\u00e4ftiger Titel f\u00fcr den Fall"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "preview",
        "detailed",
        "open",
        "waiting",
        "closed"
      ],
      "default": "open",
      "description": "Status des Falls"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Fristdatum (ohne Uhrzeit)"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Berlin",
      "description": "Zeitzone f\u00fcr die Frist"
    },
    "deadline_source": {
      "type": "string",
      "enum": [
        "manual",
        "template",
        "inferred"
      ],
      "description": "Herkunft des Fristdatums"
    },
    "notify": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "days_before": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 14
        },
        "channels": {
          "type": "object",
          "properties": {
            "email": {
              "type": "boolean",
              "default": true
            },
            "whatsapp": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "recipients": {
          "type": "object",
          "properties": {
            "customer": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "consent_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "opponent": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "whatsapp": {
                  "type": "string"
                },
                "consent_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "default": "21:00"
            },
            "end": {
              "type": "string",
              "default": "08:00"
            }
          }
        }
      }
    },
    "reminder_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "run_at": {
            "type": "string",
            "format": "date-time"
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "whatsapp"
            ]
          },
          "target": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "sent",
              "failed"
            ],
            "default": "scheduled"
          },
          "attempts": {
            "type": "integer",
            "default": 0
          },
          "last_error": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "field": {
                "type": "string"
              },
              "old_value": {
                "type": "string"
              },
              "new_value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sender_name": {
      "type": "string",
      "description": "Name des Absenders (Beh\u00f6rde, Firma, etc.)"
    },
    "sender_address": {
      "type": "string",
      "description": "Adresse des Absenders"
    },
    "reference_number": {
      "type": "string",
      "description": "Aktenzeichen, Referenz- oder Vorgangsnummer"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "description": "Datum des Dokuments/Bescheids"
    },
    "amount": {
      "type": "number",
      "description": "Betrag, um den es geht (optional)"
    },
    "objection_reason": {
      "type": "string",
      "enum": [
        "incorrect_calculation",
        "decision_unjustified",
        "deadline_missed",
        "formal_error",
        "other"
      ],
      "description": "Allgemeiner Grund f\u00fcr den Widerspruch"
    },
    "custom_reason": {
      "type": "string",
      "description": "Individueller Widerspruchsgrund"
    },
    "document_url": {
      "type": "string",
      "description": "URL zum hochgeladenen Dokument"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mehrere hochgeladene Dokument-URLs"
    },
    "additional_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Zus\u00e4tzliche Dokumente (manuell/Scanner)"
    },
    "generated_text": {
      "type": "string",
      "description": "Generierter Widerspruchstext"
    },
    "ai_validated": {
      "type": "boolean",
      "default": false,
      "description": "Ob der Text von der Doppel-Anwalt-KI validiert wurde"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe Payment Intent ID"
    },
    "language": {
      "type": "string",
      "default": "de",
      "description": "Sprache f\u00fcr den Fall"
    },
    "guest_session_id": {
      "type": "string",
      "description": "ID der zugeh\u00f6rigen Gast-Session (falls ohne Registrierung)"
    },
    "objection_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Detaillierte Widerspruchs-Kategorien, die vom Nutzer ausgew\u00e4hlt wurden"
    },
    "objection_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true,
      "description": "Strukturierte, detaillierte Begr\u00fcndungen des Nutzers"
    },
    "customer_name": {
      "type": "string",
      "description": "Name des Kunden (Empf\u00e4nger des Originalbriefs)"
    },
    "customer_address": {
      "type": "string",
      "description": "Adresse des Kunden"
    },
    "sender_data": {
      "type": "object",
      "properties": {},
      "additionalProperties": true,
      "description": "Bearbeitbare Absenderdaten f\u00fcr den Widerspruch"
    },
    "related_letters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste verkn\u00fcpfter Schreiben (Letter-IDs) zu diesem Fall"
    },
    "analysis": {
      "type": "object",
      "description": "Ergebnisse der automatischen Vorpr\u00fcfung",
      "properties": {
        "latest": {
          "type": "object",
          "additionalProperties": true
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "trashed": {
      "type": "boolean",
      "default": false,
      "description": "Im Papierkorb (Soft-Delete)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt des Verschiebens in den Papierkorb"
    },
    "trash_reason": {
      "type": "string",
      "description": "Grund/Notiz f\u00fcr das L\u00f6schen (optional)"
    }
  },
  "required": [
    "origin"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "guest_session_id": "{{guest_session.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "guest_session_id": "{{guest_session.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}